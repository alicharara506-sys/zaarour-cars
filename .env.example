# Copy to artifacts/zaarour/.env.local for local Vite development.
# Leave Supabase values blank to run the clearly labeled local demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public site origin, without a trailing slash. Set to your real deployed domain.
VITE_SITE_URL=
# Optional default WhatsApp; admin Settings overrides this after setup.
VITE_WHATSAPP_NUMBER=96100000000
# Optional VERIFIED showroom coordinates. Blank means no precise geo claims.
VITE_GEO_LATITUDE=
VITE_GEO_LONGITUDE=
# Optional confirmed Schema.org-format hours, for example Mo-Sa 09:00-19:00
VITE_OPENING_HOURS_SCHEMA=
# Local development / standalone build defaults
PORT=5173
BASE_PATH=/
